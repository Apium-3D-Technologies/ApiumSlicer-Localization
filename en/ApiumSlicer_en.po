msgstr "Force solid infill for regions having a smaller area than the specified threshold."

#: src/libslic3r/PrintConfig.cpp:5020
msgid "mm²"
msgstr "mm²"

#: src/libslic3r/PrintConfig.cpp:5026
msgid "Solid infill extruder"
msgstr "Solid infill extruder"

#: src/libslic3r/PrintConfig.cpp:5028
