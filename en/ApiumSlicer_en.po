msgstr "Loading speed at the start"

#: src/libslic3r/PrintConfig.cpp:1178
msgid "Speed used at the very beginning of loading phase."
msgstr "Speed used at the very beginning of loading phase."

#: src/libslic3r/PrintConfig.cpp:1185
msgid "Unloading speed"
msgstr "Unloading speed"

#: src/libslic3r/PrintConfig.cpp:1186
msgid ""
"Speed used for unloading the material on the wipe tower (does not affect  "
"initial part of unloading just after ramming)."
msgstr ""
"Speed used for unloading the material on the wipe tower (does not affect  "
"initial part of unloading just after ramming)."

#: src/libslic3r/PrintConfig.cpp:1194
msgid "Unloading speed at the start"
msgstr "Unloading speed at the start"

#: src/libslic3r/PrintConfig.cpp:1195
msgid ""
"Speed used for unloading the tip of the material immediately after ramming."
msgstr ""
"Speed used for unloading the tip of the material immediately after ramming."

#: src/libslic3r/PrintConfig.cpp:1202
msgid "Delay after unloading"
msgstr "Delay after unloading"

#: src/libslic3r/PrintConfig.cpp:1203
msgid ""
"Time to wait after the material is unloaded. May help to get reliable "
"toolchanges with flexible materials that may need more time to shrink to "
