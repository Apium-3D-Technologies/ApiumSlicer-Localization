msgstr "(Unknown)"

#: src/libslic3r/PrintConfig.cpp:1405
msgid "Shrinkage compensation XY"
msgstr "Shrinkage compensation XY"

#: src/libslic3r/PrintConfig.cpp:1406
msgid ""
"Enter your material shrinkage percentages for the X and Y axes here to apply "
"scaling of the object to compensate for shrinkage in the X and Y axes. For "
"example, if you measured 99mm instead of 100mm, enter 1%."
msgstr ""
"Enter your material shrinkage percentages for the X and Y axes here to apply "
"scaling of the object to compensate for shrinkage in the X and Y axes. For "
"example, if you measured 99mm instead of 100mm, enter 1%."

#: src/libslic3r/PrintConfig.cpp:1416
msgid "Shrinkage compensation Z"
msgstr "Shrinkage compensation Z"

#: src/libslic3r/PrintConfig.cpp:1417
msgid ""
"Enter your material shrinkage percentages for the Z axis here to apply "
"scaling of the object to compensate for shrinkage in the Z axis. For "
"example, if you measured 99mm instead of 100mm, enter 1%."
msgstr ""
"Enter your material shrinkage percentages for the Z axis here to apply "
"scaling of the object to compensate for shrinkage in the Z axis. For "
"example, if you measured 99mm instead of 100mm, enter 1%."

#: src/libslic3r/PrintConfig.cpp:1427
msgid "Fill angle"
msgstr "Fill angle"

#: src/libslic3r/PrintConfig.cpp:1429
msgid ""
"Base angle for the selected infill pattern. Cross-hatching will be applied "
"to this. Automatically detected bridge directions may override this value."
msgstr ""
"Base angle for the selected infill pattern. Cross-hatching will be applied "
"to this. Automatically detected bridge directions may override this value."

