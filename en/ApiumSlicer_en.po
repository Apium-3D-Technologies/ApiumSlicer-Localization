msgstr "Multiplier applied to brim and skirt extrusions."

#: src/libslic3r/PrintConfig.cpp:2227
msgid "Enable purge line"
msgstr "Enable purge line"

#: src/libslic3r/PrintConfig.cpp:2229
msgid "If enabled, a purge line is extruded after start G-code and before printing."
msgstr "If enabled, a purge line is extruded after start G-code and before printing."

#: src/libslic3r/PrintConfig.cpp:2234
