msgstr "Max scarf joint segment length"

#: src/libslic3r/PrintConfig.cpp:4921
msgid "Maximum length of any scarf joint segment."
msgstr "Maximum length of any scarf joint segment."

#: src/libslic3r/PrintConfig.cpp:4928
msgid "Scarf joint on inner perimeters"
msgstr "Scarf joint on inner perimeters"

#: src/libslic3r/PrintConfig.cpp:4930
