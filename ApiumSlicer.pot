msgstr ""

#: src/libslic3r/PrintConfig.cpp:5679
msgid "Support material/raft interface extruder"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5681
msgid ""
"The tool to use when printing support material interface. Choose 'Current extruder' to minimize "
"tool changes. This affects raft too."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5688
msgid "Top interface layers"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5690
msgid "Number of interface layers to insert between the object(s) and support material."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5694 src/libslic3r/PrintConfig.cpp:5712
