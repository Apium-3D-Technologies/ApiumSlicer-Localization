msgid "Below Z"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4855
msgid "Only lift Z below"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4856
msgid ""
"If you set this to a positive value, Z lift will only take place below the specified absolute Z. "
"You can tune this setting for limiting lift to the first layers."
msgstr ""

