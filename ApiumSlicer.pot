msgstr ""

#: src/libslic3r/PrintConfig.cpp:2797
msgid "Spool weight"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2798
msgid ""
"Enter weight of the empty material spool. One may weigh a partially consumed material spool "
"before printing and one may compare the measured weight with the calculated weight of the "
"material with the spool to find out whether the amount of material on the spool is sufficient to "
"finish the print."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2802 src/slic3r/GUI/GCodeViewer.cpp:3763
#: src/slic3r/GUI/GCodeViewer.cpp:4018
msgid "g"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2812 src/libslic3r/PrintConfig.cpp:7349
