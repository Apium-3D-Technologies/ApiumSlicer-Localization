msgstr ""

#: src/libslic3r/PrintConfig.cpp:5695 src/libslic3r/PrintConfig.cpp:5713
msgid "1 (light)"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5696 src/libslic3r/PrintConfig.cpp:5714
msgid "2 (default)"
