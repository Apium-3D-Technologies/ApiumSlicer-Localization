msgstr ""

#: src/libslic3r/PrintConfig.cpp:5751
msgid "Interface pattern spacing"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5753
msgid "Spacing between interface lines. Set zero to get a solid interface."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5762
msgid ""
"Speed for printing support material interface layers. If expressed as percentage (for example "
"50%) it will be calculated over support material speed."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5771
msgid "Pattern"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5773
msgid "Pattern used to generate support material."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5783
msgid "Interface pattern"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5785
msgid ""
"Pattern used to generate support material interface. Default pattern for non-soluble support "
"interface is Rectilinear, while default pattern for soluble support interface is Concentric."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5797
msgid "Pattern spacing"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5799
msgid "Spacing between support material lines."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:5808
