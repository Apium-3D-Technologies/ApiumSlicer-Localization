#: src/libslic3r/PrintConfig.cpp:4472
msgid "Printer vendor"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4473
msgid "Name of the printer vendor."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4478
msgid "Printer variant"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4479
msgid ""
"Name of the printer variant. For example, the printer variants may be differentiated by a nozzle "
"diameter."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4496
msgid "Raft contact Z distance"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4498
msgid "The vertical distance between object and raft. Ignored for soluble interface."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4505
msgid "Enable raft"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4507
msgid "Enable raft generation. When disabled, raft settings are stored but ignored during slicing."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4512
msgid "Raft expansion"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4514
msgid "Expansion of the raft in XY plane for better stability."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4521
msgid "First layer density"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4523
msgid "Density of the first raft or support layer."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4531
msgid "First layer expansion"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4533
msgid "Expansion of the first raft or support layer to improve adhesion to print bed."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4540
msgid "Raft layers"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4542
msgid ""
"The object will be raised by this number of layers, and support material will be generated under "
"it."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4550
msgid "Raft interface layers"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4552
msgid "Number of raft interface layers to generate. This includes the top raft contact layer."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4559
msgid "Raft base pattern"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4561
msgid ""
"Fill pattern for raft base layers. Honeycomb provides better adhesion and rigidity, while "
"rectilinear is faster to print."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4572
msgid "Raft base pattern spacing"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4574
msgid "Spacing between raft base pattern lines. Smaller values produce a denser raft."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4582
msgid "Slice resolution"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4583
msgid ""
"Minimum detail resolution, used to simplify the input file for speeding up the slicing job and "
"reducing memory usage. High-resolution models often carry more detail than printers can render. "
"Set to zero to disable any simplification and use full resolution from input."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4593
msgid "G-code resolution"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4594
msgid ""
"Maximum deviation of exported G-code paths from their full resolution counterparts. Very high "
"resolution G-code requires huge amount of RAM to slice and preview, also a 3D printer may stutter "
"not being able to process a high resolution G-code in a timely manner. On the other hand, a low "
"resolution G-code will produce a low poly effect and because the G-code reduction is performed at "
"each layer independently, visible artifacts may be produced."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4605
msgid "Minimum travel after retraction"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4606
msgid "Retraction is not triggered when travel moves are shorter than this length."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4612
msgid "Retract amount before wipe"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4613
msgid ""
"With bowden extruders, it may be wise to do some amount of quick retract before doing the wipe "
"movement."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4620
msgid "Retract on layer change"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4621
msgid "This flag enforces a retraction whenever a Z move is done."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4626
msgid "Retract after purge line"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4627
msgid ""
"If enabled, perform standard retraction after the purge line. If disabled, the first retraction "
"after purge line is skipped."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4632
msgid "Retraction length"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4633
msgid "Retraction Length"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4634
msgid ""
"When retraction is triggered, material is pulled back by the specified amount (the length is "
"measured on raw material, before it enters the extruder)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4641 src/slic3r/GUI/Gizmos/GLGizmoMeasure.cpp:2207
msgid "Length"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4642
msgid "Retraction Length (Toolchange)"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4643
msgid ""
"When retraction is triggered before changing tool, material is pulled back by the specified "
"amount (the length is measured on raw material, before it enters the extruder)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4651
msgid "Ramping slope angle"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4652
msgid "Slope of the ramp in the initial phase of the travel."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4660
msgid "Use ramping lift"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4661
msgid ""
"Generates a ramping lift instead of lifting the extruder directly upwards. The travel is split "
"into two phases: the ramp and the standard horizontal travel. This option helps reduce stringing."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4668
msgid "Maximum ramping lift"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4669
msgid ""
"Maximum lift height of the ramping lift. It may not be reached if the next position is close to "
"the old one."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4678
msgid "Steeper ramp before obstacles"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4679
msgid ""
"If enabled, PrusaSlicer detects obstacles along the travel path and makes the slope steeper in "
"case an obstacle might be hit during the initial phase of the travel."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4685
msgid "High flow nozzle"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4686
msgid "High flow nozzles allow higher print speeds."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4691
msgid "Max. nozzle temperature"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4692
msgid ""
"Maximum nozzle target allowed for this printhead. Slicing fails if a selected material or emitted "
"G-code exceeds this temperature."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4700
msgid "Allow excessive extrusion widths"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4701
msgid ""
"Disables the excessive extrusion width safety error for this extruder. The safety error is "
"disabled only if this option is enabled for all extruders. Use with caution."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4707
msgid "Minimum extrusion multiplier warning"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4708
msgid ""
"Warning threshold for final extrusion multiplier (line type multiplier times material extrusion "
"multiplier). A non-blocking slicing warning is shown when the final multiplier falls below this "
"value. Set to 0 to disable warnings."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4716
msgid "Nozzle temperature deviation warning"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4717
msgid ""
"Warning threshold for nozzle temperature variation during slicing. A non-blocking slicing warning "
"is shown when the temperature delta (maximum minus minimum) for any used toolhead exceeds this "
"value. Idle/cooldown temperatures are ignored. Set to 0 to disable warnings."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4727
msgid "Printbed temperature deviation warning"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4728
msgid ""
"Warning threshold for print bed temperature variation during slicing. A non-blocking slicing "
"warning is shown when the bed temperature delta (maximum minus minimum) exceeds this value. Set "
"to 0 to disable warnings."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4737
msgid "Lift height"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4738
msgid "Lift height applied before travel."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4746
msgid "Above Z"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4747
msgid "Only lift Z above"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4748
msgid ""
"If you set this to a positive value, Z lift will only take place above the specified absolute Z. "
"You can tune this setting for skipping lift on the first layers."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4755
msgid "Below Z"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4756
msgid "Only lift Z below"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4757
msgid ""
"If you set this to a positive value, Z lift will only take place below the specified absolute Z. "
"You can tune this setting for limiting lift to the first layers."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4765
msgid "Deretraction extra length"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4766
msgid ""
"When the retraction is compensated after the travel move, the extruder will push this additional "
"amount of material. This setting is rarely needed."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4773
msgid "Extra length on restart"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4774
msgid ""
"When the retraction is compensated after changing tool, the extruder will push this additional "
"amount of material."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4781 src/libslic3r/PrintConfig.cpp:4782
msgid "Retraction Speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4783
msgid "The speed for retractions (it only applies to the extruder motor)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4789 src/libslic3r/PrintConfig.cpp:4790
msgid "Deretraction Speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4791
msgid ""
"The speed for loading of material into extruder after retraction (it only applies to the extruder "
"motor). If left to zero, the retraction speed is used."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4798
msgid "Coasting distance"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4799
msgid ""
"Distance before a retraction point where extrusion is stopped and the nozzle only moves. "
"Currently applied only to retractions after Perimeter and External perimeter extrusions. When "
"enabled, Retract on layer change is forced on and Minimum travel after retraction is forced to 0 "
"mm to reduce seam unevenness at coasting retraction points."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4809
msgid "Seam gap distance"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4810
msgid ""
"The distance between the endpoints of a closed loop perimeter. Positive values will shorten and "
"interrupt the loop slightly to reduce the seam. Negative values will extend the loop, causing the "
"endpoints to overlap slightly. When percents are used, the distance is derived from the nozzle "
"diameter. Set to zero to disable this feature."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4820
msgid "Seam position"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:4822
msgid "Position of perimeters starting points."
msgstr ""

