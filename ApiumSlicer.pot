msgid "Extrusion Multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2170
msgid ""
"Multiplier applied to object extrusions on the first object layer. This does not apply to brim/"
"skirt, support, or raft extrusions. The final extrusion is this multiplier times material "
"extrusion multiplier."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2179
msgid "Object first layer cumulative calculation"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2181
msgid ""
"If disabled, object extrusions on the first object layer use only Object first layer extrusion "
"multiplier. If enabled, object first layer multiplier is multiplied with the line type multiplier "
"(bridge, perimeter, infill, etc.)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2187
msgid "Perimeter extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2189
msgid ""
"Multiplier applied to perimeter and gap fill extrusions. External perimeter uses its own "
"multiplier."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2196
msgid "External perimeter extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2198
msgid "Multiplier applied to external perimeter extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2205
msgid "Infill extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2207
msgid "Multiplier applied to internal infill extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2214
msgid "Solid fill extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2216
msgid ""
"Multiplier applied to solid infill extrusions except top solid infill, which has its own "
"multiplier."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2223
msgid "Top solid fill extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2225
msgid ""
"Multiplier applied to top solid infill extrusions. This overrides solid fill extrusion multiplier "
"for top solid infill."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2232
msgid "Support material extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2234
msgid "Multiplier applied to support material and support interface extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2241
msgid "Bridge extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2243
msgid ""
"Multiplier applied to bridge extrusions. Bridge multiplier has priority over other line type "
"multipliers."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2250
msgid "Bridge infill extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2252
msgid "Multiplier applied to bridge infill extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2259 src/libslic3r/PrintConfig.cpp:6066
msgid "Nozzle temperature"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2260 src/slic3r/GUI/GCodeViewer.cpp:1325
#: src/slic3r/GUI/GUI_Factories.cpp:105 src/slic3r/GUI/GUI_Factories.cpp:191
#: src/slic3r/GUI/Tab.cpp:4810
msgid "Temperature"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2261
msgid ""
"Nozzle temperature applied while printing inside this local object region. The value applies to "
"whichever extruder is active. Set to 0 to inherit the temperature that would otherwise apply at "
"this position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2271
msgid "Cooling fan speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2272 src/slic3r/GUI/GUI_Factories.cpp:106
#: src/slic3r/GUI/GUI_Factories.cpp:192 src/slic3r/GUI/Tab.cpp:4985
msgid "Cooling"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2273
msgid ""
"Part cooling fan speed applied while printing inside this local object region. Set to -1 to "
"inherit the fan speed that would otherwise apply at this position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2282
msgid "Zoneheater power multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2283 src/libslic3r/PrintConfig.cpp:2293
#: src/slic3r/GUI/GUI_Factories.cpp:107 src/slic3r/GUI/GUI_Factories.cpp:193
msgid "Zoneheater"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2284
msgid "Multiplier applied to zoneheater target power inside this modifier region."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2292
msgid "Zoneheater power"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2294
msgid ""
"Zoneheater target power applied inside this local object region. Set to -1 to inherit the target "
"that would otherwise apply at this position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2308
msgid "Raft extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2310
msgid "Multiplier applied to raft extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2317
msgid "Brim/Skirt extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2319
msgid "Multiplier applied to brim and skirt extrusions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2326
msgid "Enable purge line"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2328
msgid "If enabled, a purge line is extruded after start G-code and before printing."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2333
msgid "Allow outside build area placement"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2335
msgid ""
"If enabled, purge line coordinates are accepted without errors even when they are outside the "
"print area or inside exclusion zones."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2340
msgid "Purge line Z-hop"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2342
msgid ""
"Bed lowering distance before moving to the purge line start position. This helps avoid collisions "
"with bed clips."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2349
msgid "Start X"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2351
msgid "X coordinate of the purge line start position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2357
msgid "Start Y"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2359
msgid "Y coordinate of the purge line start position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2365
msgid "End X"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2367
msgid "X coordinate of the purge line end position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2373
msgid "End Y"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2375
msgid "Y coordinate of the purge line end position."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2381
msgid "Purge line extrusion type"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2383
msgid "Selects which extrusion width and multiplier are used for the purge line."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2386 src/libslic3r/PrintConfig.cpp:3299
#: src/libslic3r/PrintConfig.cpp:3317 src/libslic3r/PrintConfig.cpp:3327
#: src/libslic3r/PrintConfig.cpp:3406 src/libslic3r/PrintConfig.cpp:4354
#: src/slic3r/GUI/GCodeViewer.cpp:4683
msgid "First layer"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2395
msgid "Purge line extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2397
msgid ""
"Multiplier applied to purge line extrusions when the purge line extrusion type is set to Custom."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2404
msgid "Purge line extrusion width"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2406
msgid ""
"Sets a manual extrusion width for the purge line when the purge line extrusion type is set to "
"Custom. If left at zero, the default extrusion width will be used. Percentage values are computed "
"over the selected calculation base."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2414
msgid ""
"Base for percentage-based purge line extrusion width calculation. Used only for percentage values."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2426
msgid ""
"This separate setting will affect the speed of external perimeters (the visible ones). If "
"expressed as percentage (for example: 80%) it will be calculated on the perimeters speed setting "
"above. Set to zero for auto."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2436
msgid "External perimeters first"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2438
msgid ""
"Print contour perimeters from the outermost one to the innermost one instead of the default "
"inverse order."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2444
msgid "Perimeter printing order"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2446
msgid "Controls the order in which perimeters are printed."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2448
msgid "Outer → Inner"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2449
msgid "Inner → Outer"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2450
msgid "Outer → Innermost → Inner"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2451
msgid "Innermost → Outer → Inner"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2457
msgid "Extra perimeters if needed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2459
msgid ""
"Add more perimeters when needed for avoiding gaps in sloping walls. Slic3r keeps adding "
"perimeters, until more than 70% of the loop immediately above is supported."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2466
msgid "Extra perimeters on overhangs (Experimental)"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2468
msgid ""
"Detect overhang areas where bridges cannot be anchored, and fill them with extra perimeter paths. "
"These paths are anchored to the nearby non-overhang area when possible."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2474 src/slic3r/GUI/wxExtensions.cpp:394
msgid "Extruder"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2476
msgid ""
"The extruder to use (unless more specific extruder settings are specified). This value overrides "
"perimeter and infill extruders, but not the support extruders."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2480
msgid "default"
msgstr ""

#. TRN - Input label. Be short as possible
#. Height of one text line - Font Ascent
#: src/libslic3r/PrintConfig.cpp:2483 src/slic3r/GUI/GCodeViewer.cpp:1280
#: src/slic3r/GUI/Gizmos/GLGizmoEmboss.cpp:4553
msgid "Height"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2484
msgid ""
"Only used when 'Print Settings -> Complete individual objects' is active. Set this to the "
"vertical distance between your nozzle tip and (usually) the X carriage rods. Used to check for "
"collisions with previously printed objects and to prevent them when arranging.\n"
"The value is ignored for most Prusa printers, which come with more detailed extruder model."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2494
msgid "Radius"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2495
msgid ""
"Only used when 'Print Settings -> Complete individual objects' is active. Set this to a radius of "
"a nozzle-centered cylinder big enough to enclose the extruder assembly. Used to check for "
"collisions with previously printed objects and to prevent them when arranging.\n"
"The value is ignored for most Prusa printers, which come with more detailed extruder model."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2505
msgid "Extruder Color"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2506 src/libslic3r/PrintConfig.cpp:2601
#: src/libslic3r/PrintConfig.cpp:7298
msgid "This is only used in the Slic3r interface as a visual help."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2512
msgid "Extruder offset"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2513
msgid ""
"If your firmware doesn't handle the extruder displacement you need the G-code to take it into "
"account. This option lets you specify the displacement of each extruder with respect to the first "
"one. It expects positive coordinates (they will be subtracted from the XY coordinate)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2522
msgid "Extrusion axis"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2523
msgid ""
"Use this option to set the axis letter associated to your printer's extruder (usually E but some "
"printers use A)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2528 src/slic3r/GUI/GCodeViewer.cpp:1270
#: src/slic3r/GUI/GCodeViewer.cpp:4118 src/slic3r/GUI/GCodeViewer.cpp:4141
#: src/slic3r/GUI/Tab.cpp:2760
msgid "Extrusion multiplier"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2529
msgid ""
"This factor changes the amount of flow proportionally. You may need to tweak this setting to get "
"nice surface finish and correct single wall widths. Usual values are between 0.9 and 1.1. If you "
"think you need to change this more, check material diameter and your firmware E steps."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2538
msgid "Enable pressure advance"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2539
msgid "Enable pressure advance for this filament profile."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2544 src/slic3r/GUI/GCodeViewer.cpp:1329
msgid "Pressure advance"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2545
msgid "Pressure advance (Klipper) or linear advance factor (Marlin) for this filament profile."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2551
msgid "Default extrusion width"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2553
msgid ""
"Set this to a non-zero value to allow a manual extrusion width. If left to zero, Slic3r derives "
"extrusion widths from the nozzle diameter (see the tooltips for perimeter extrusion width, infill "
"extrusion width etc). If expressed as percentage (for example: 230%), it will be computed over "
"the selected calculation base."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2567
msgid ""
"Base for percentage-based default extrusion width calculation. Used only for percentage values."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2577
msgid "Keep fan always on"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2578
msgid ""
"If this is enabled, fan will never be disabled and will be kept running at least at its minimum "
"speed. Useful for PLA, harmful for ABS."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2583
msgid "Enforce fan off"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2584
msgid ""
"Force the part cooling fan off whenever cooling control is disabled. Useful when external "
"commands may switch the fan on during print."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2590
msgid "Enable fan if layer print time is below"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2591
msgid ""
"If layer print time is estimated below this number of seconds, fan will be enabled and its speed "
"will be calculated by interpolating the minimum and maximum speeds."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2593 src/libslic3r/PrintConfig.cpp:5097
msgid "approximate seconds"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2606
msgid "Material notes"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2607
msgid "You can put your notes regarding the material here."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2615 src/libslic3r/PrintConfig.cpp:4225
msgid "Max volumetric speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2616
msgid ""
"Maximum volumetric speed allowed for this material. Limits the maximum volumetric speed of a "
"print to the minimum of print and material volumetric speed. Set to zero for no limit."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2619 src/libslic3r/PrintConfig.cpp:2812
#: src/libslic3r/PrintConfig.cpp:4228 src/slic3r/GUI/GCodeViewer.cpp:1305
#: src/slic3r/GUI/RammingChart.cpp:99
msgid "mm³/s"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2625
msgid "Max non-crossing infill speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2626
msgid ""
"Maximum speed allowed for this material while printing infill without any self intersections in a "
"single layer. Set to zero for no limit."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2635
msgid "Min. extrusion temperature"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2636
msgid ""
"Minimum allowed nozzle target while this material is being extruded. Idle, standby and cooldown "
"temperatures may be lower when no extrusion occurs."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2645
msgid "Max. extrusion temperature"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2646
msgid ""
"Maximum allowed nozzle target while this material is being extruded. Violations in generated, "
"slider or custom G-code are reported as slicing warnings."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2655
msgid "Max crossing infill speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2656
msgid ""
"Maximum speed allowed for this material while printing infill with self intersections in a single "
"layer. Set to zero for no limit."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2665
msgid "Loading speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2666
msgid "Speed used for loading the material on the wipe tower."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2673
msgid "Loading speed at the start"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2674
msgid "Speed used at the very beginning of loading phase."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2681
msgid "Unloading speed"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2682
msgid ""
"Speed used for unloading the material on the wipe tower (does not affect  initial part of "
"unloading just after ramming)."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2690
msgid "Unloading speed at the start"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2691
msgid "Speed used for unloading the tip of the material immediately after ramming."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2698
msgid "Delay after unloading"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2699
msgid ""
"Time to wait after the material is unloaded. May help to get reliable toolchanges with flexible "
"materials that may need more time to shrink to original dimensions."
msgstr ""

#: src/libslic3r/PrintConfig.cpp:2702 src/libslic3r/PrintConfig.cpp:2773
#: src/libslic3r/PrintConfig.cpp:2788 src/libslic3r/PrintConfig.cpp:7190
#: src/libslic3r/PrintConfig.cpp:7199 src/libslic3r/PrintConfig.cpp:7208
#: src/libslic3r/PrintConfig.cpp:7366 src/libslic3r/PrintConfig.cpp:7374
#: src/libslic3r/PrintConfig.cpp:7382 src/libslic3r/PrintConfig.cpp:7389
#: src/libslic3r/PrintConfig.cpp:7397 src/libslic3r/PrintConfig.cpp:7405
#: src/libslic3r/PrintConfig.cpp:7743 src/libslic3r/PrintConfig.cpp:7752
